{
  "rules": {
    "comments": {
      "$page_id": {
        ".read": true,
        "$comment_id": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['author', 'text', 'timestamp', 'likes', 'dislikes'])",
          "author": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "text": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
          },
          "timestamp": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "likes": {
            ".write": "auth != null && data.exists() && newData.isNumber() && newData.val() == data.val() + 1",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "dislikes": {
            ".write": "auth != null && data.exists() && newData.isNumber() && newData.val() == data.val() + 1",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "pageUrl": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val().length <= 2048"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}